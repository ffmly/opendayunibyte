# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only secrets — never prefix these with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=replace_with_server_secret
DATABASE_URL=replace_with_postgres_connection_string

# Public origin used inside printed QR codes. Use the production URL on Vercel.
NEXT_PUBLIC_APP_URL=https://your-open-day.vercel.app

# Unsigned Cloudinary workshop image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dleloafvw
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=localmenia
